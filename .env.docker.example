# Пример переменных для `docker compose up --build` (корень репозитория).
# Скопируйте: cp .env.docker.example .env  — и при необходимости измените значения.

# Порты, публикуемые на хосте
FRONTEND_PORT=8080
BACKEND_PORT=8000

# PostgreSQL внутри compose-сети
PGDATABASE=alfa-hakaton
PGUSER=postgres
PGPASSWORD=postgres

# Секрет подписи Bearer-токенов (для production обязательно замените:
# openssl rand -hex 32)
AUTH_SECRET=local-docker-secret-change-me

# CORS для backend (frontend в Docker ходит через nginx-proxy на тот же origin)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
