{
  "info": {
    "name": "alfa-hakaton-DVSN API",
    "description": "Коллекция для E2E: клиент создаёт заявку, сотрудник формирует предложение, клиент принимает его. Запускать папку E2E после Login client / Login bank.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "inn",
      "value": "3662277634"
    },
    {
      "key": "productId",
      "value": "7"
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "bankToken",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00. Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database ok\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login client (business)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"client\",\n  \"password\": \"client\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"clientToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login bank (employee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bank\",\n  \"password\": \"bank\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"bankToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Reference data",
      "item": [
        {
          "name": "Company by INN",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/companies/{{inn}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "companies",
                "{{inn}}"
              ]
            }
          }
        },
        {
          "name": "Loan products (public selection)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-products?amount=1000000&term_months=12&business_category=ip&purpose=other&business_age_months=36&allow_fallback=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-products?amount=1000000&term_months=12&business_category=ip&purpose=other&business_age_months=36&allow_fallback=true"
              ]
            }
          }
        },
        {
          "name": "Loan products catalog (employee)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bankToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-products/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-products",
                "catalog"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "E2E: manual offer -> select",
      "item": [
        {
          "name": "Create application (manual review)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inn\": \"3662277634\",\n  \"product_id\": 7,\n  \"requested_amount\": 1000000,\n  \"requested_term_months\": 12,\n  \"loan_purpose\": \"other\",\n  \"business_age_months\": 36\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Цель other гарантированно переводит заявку на ручную проверку.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"applicationId\", pm.response.json().application_id);",
                  "pm.test(\"manual_review\", () => pm.expect(pm.response.json().status).to.eql(\"manual_review\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications?limit=50"
              ]
            }
          }
        },
        {
          "name": "Employee manual queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bankToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications?status=manual_review&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications?status=manual_review&limit=50"
              ]
            }
          }
        },
        {
          "name": "Application detail (client)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}"
              ]
            }
          }
        },
        {
          "name": "Create employee offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bankToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}/employee-offer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}",
                "employee-offer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 7,\n  \"approved_amount\": 1200000,\n  \"approved_term_months\": 18,\n  \"reason\": \"Индивидуальные условия для клиента\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"offer_pending\", () => pm.expect(pm.response.json().status).to.eql(\"offer_pending\"));",
                  "const offers = pm.response.json().offers || []; const offer = offers.find(o => o.source === \"bank_employee\");",
                  "if (offer) { pm.collectionVariables.set(\"offerId\", offer.offer_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Application detail after offer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}"
              ]
            }
          }
        },
        {
          "name": "Select offer (client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}/offers/{{offerId}}/select",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}",
                "offers",
                "{{offerId}}",
                "select"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"approved\", () => pm.expect(pm.response.json().status).to.eql(\"approved\"));",
                  "pm.test(\"decision is bank_employee\", () => pm.expect(pm.response.json().decision.decision_source).to.eql(\"bank_employee\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Alternative scenarios (run separately)",
      "item": [
        {
          "name": "Decline offer (alternative scenario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}/offers/{{offerId}}/decline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}",
                "offers",
                "{{offerId}}",
                "decline"
              ]
            }
          },
          "description": "Альтернатива выбору: использовать на новой заявке с offer_pending."
        },
        {
          "name": "Employee approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bankToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"approved_amount\": 900000,\n  \"approved_term_months\": 10,\n  \"reason\": \"Одобрено сотрудником банка\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Для новой заявки в статусе manual_review; не запускать после выбора оффера."
        },
        {
          "name": "Employee reject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bankToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loan-applications/{{applicationId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loan-applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"rejected\",\n  \"reason\": \"Отказ по кредитной политике\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Для новой заявки в статусе manual_review."
        }
      ]
    }
  ]
}
