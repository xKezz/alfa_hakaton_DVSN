# Локальная конфигурация для быстрого старта.
# Скопируйте: cp .env.example .env
# .env добавлен в .gitignore; этот файл содержит только локальные dev-значения.

# --- Подключение к PostgreSQL ---
# Стандартный локальный PostgreSQL (как в src/db/setup_db.py):
PGHOST=localhost
PGPORT=5432
PGDATABASE=alfa-hakaton
PGUSER=postgres
PGPASSWORD=postgres

# Альтернатива: одна строка подключения (имеет приоритет над PG*):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alfa-hakaton

# --- HTTP-сервер ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Подпись Bearer-токенов ---
# Для локального запуска подходит это значение.
# В production обязательно замените на случайное: openssl rand -hex 32.
AUTH_SECRET=local-dev-secret-alfa-hakaton-dvsn-change-in-production
