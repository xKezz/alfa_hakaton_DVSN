# Скопируйте этот файл в .env и укажите свои значения:
#   cp .env.example .env
# .env добавлен в .gitignore — реальные секреты в репозиторий не коммитятся.

# --- Подключение к PostgreSQL ---
# Вариант 1 (приоритетный): одна строка подключения.
# Если DATABASE_URL задан, разрозненные PG* ниже игнорируются.
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/alfa_hakaton

# Вариант 2: разрозненные параметры (используются, если DATABASE_URL не задан).
PGHOST=localhost
PGPORT=5432
PGDATABASE=alfa_hakaton
PGUSER=postgres
PGPASSWORD=1234

# --- HTTP-сервер ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- CORS (origins через запятую, без пробелов вокруг запятых) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
